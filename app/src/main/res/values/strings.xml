    <!-- Help - Data Structure -->
    <string name="help_title">帮助</string>
    <string name="help_section_data_title">数据结构</string>
    <string name="help_data_intro">应用采用三级分类体系：分类→章节→图片，数据通过统一响应体 ApiResponse&lt;T&gt; 封装返回。</string>

    <string name="help_data_model_title">▎统一响应体 ApiResponse&lt;T&gt;</string>
    <string name="help_data_model_content" formatted="false">字段说明：
  · code    - int，状态码（200 表示成功）
  · msg     - String，响应消息
  · data    - T，泛型数据体
  · isSuccess() - code == 200 时返回 true

包路径：com.operit.netimageviewer.data.model.ApiResponse</string>

    <string name="help_data_classify_title">▎一级分类：ClassifyItem</string>
    <string name="help_data_classify_content" formatted="false">字段说明：
  · id     - int，分类 ID（主键）
  · title  - String，分类名称
  · cover  - String，封面图片 URL

作用：表示图片分类目录（如"动漫"、"风景"等）</string>

    <string name="help_data_chapter_title">▎二级章节：ChapterItem</string>
    <string name="help_data_chapter_content" formatted="false">字段说明：
  · id        - int，章节 ID（主键）
  · title     - String，章节名称
  · cover     - String，封面图片 URL
  · pageCount - int，页数

作用：表示分类下的具体章节/专辑</string>

    <string name="help_data_picture_title">▎三级图片：PictureItem</string>
    <string name="help_data_picture_content" formatted="false">字段说明：
  · id    - int，图片 ID（主键）
  · url   - String，图片链接
  · order - int，图片排序序号

作用：表示章节内的单张图片，按 order 升序排列</string>

    <!-- Help - API Structure -->
    <string name="help_section_api_title">API 结构</string>
    <string name="help_api_intro">所有 API 端点通过 Retrofit 请求服务端 api.php，支持用户自定义 base URL。
网络层位于 com.operit.netimageviewer.data.remote 包。</string>
    <string name="help_api_endpoint_intro" formatted="false">请求方式：全部为 GET 请求
基础路径：{baseURL}/api.php

</string>

    <string name="help_api_endpoint1_title" formatted="false">端点 1：获取分类列表</string>
    <string name="help_api_endpoint1_content" formatted="false">▸ GET {baseURL}/api.php?action=classifyList
▸ 参数：无
▸ 返回：Call&lt;ApiResponse&lt;List&lt;ClassifyItem&gt;&gt;&gt;
▸ 说明：获取所有一级分类</string>

    <string name="help_api_endpoint2_title" formatted="false">端点 2：获取章节列表</string>
    <string name="help_api_endpoint2_content" formatted="false">▸ GET {baseURL}/api.php?action=chapterList&amp;id={classifyId}
▸ 参数：id - 分类 ID（int）
▸ 返回：Call&lt;ApiResponse&lt;List&lt;ChapterItem&gt;&gt;&gt;
▸ 说明：获取指定分类下的章节列表</string>

    <string name="help_api_endpoint3_title" formatted="false">端点 3：获取图片列表</string>
    <string name="help_api_endpoint3_content" formatted="false">▸ GET {baseURL}/api.php?action=pictureList&amp;id={chapterId}
▸ 参数：id - 章节 ID（int）
▸ 返回：Call&lt;ApiResponse&lt;List&lt;PictureItem&gt;&gt;&gt;
▸ 说明：获取指定章节下的图片列表</string>

    <!-- Help - Network Layer -->
    <string name="help_section_network_title">网络层配置</string>
    <string name="help_network_content" formatted="false">OkHttp 配置：
  · 连接超时：15 秒
  · 读取超时：30 秒
  · 写入超时：30 秒
  · 缓存目录：http_cache（10MB）
  · 日志级别：HttpLoggingInterceptor.Level.BODY

Retrofit 配置：
  · 双检锁单例模式（RetrofitClient）
  · 动态 baseURL（通过 SharedPreferences 存储）
  · Gson 序列化/反序列化
  · @SerializedName 注解绑定 JSON 字段</string>

    <!-- Help - Database Structure -->
    <string name="help_section_db_title">数据库结构</string>
    <string name="help_db_intro" formatted="false">本地使用 Room 数据库（net_image_viewer_db，version=2）
存储缓存、浏览历史和收藏数据。位于 data.local 包。

</string>

    <string name="help_db_table1" formatted="false">表 1：classify_cache（分类缓存）
  · id    - int，主键，分类 ID
  · title - String，分类名称
  · cover - String，封面 URL
  作用：缓存服务端返回的分类列表</string>

    <string name="help_db_table2" formatted="false">表 2：chapter_cache（章节缓存）
  · id         - int，主键，章节 ID
  · classifyId - int，所属分类 ID
  · title      - String，章节名称
  · cover      - String，封面 URL
  · pageCount  - int，页数
  作用：缓存服务端返回的章节列表</string>

    <string name="help_db_table3" formatted="false">表 3：picture_cache（图片缓存）
  · id         - int，主键，图片 ID
  · chapterId  - int，所属章节 ID
  · url        - String，图片链接
  · orderIndex - int，排序序号
  作用：缓存服务端返回的图片列表</string>

    <string name="help_db_table4" formatted="false">表 4：browse_history（浏览历史）
  · id           - int，自增主键
  · chapterId    - int，唯一索引，章节 ID
  · chapterTitle - String，章节标题
  · coverUrl     - String，封面 URL
  · browseTime   - long，浏览时间戳
  作用：记录用户浏览过的章节</string>

    <string name="help_db_table5" formatted="false">表 5：favorites（收藏）
  · id           - int，自增主键
  · chapterId    - int，章节 ID
  · chapterTitle - String，章节标题
  · coverUrl     - String，封面 URL
  · favoriteTime - long，收藏时间戳
  · note         - String，备注
  作用：用户收藏的章节</string>

